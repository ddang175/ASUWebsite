{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/about/?$",
			"dest": "_render"
		},
		{
			"src": "^/board/?$",
			"dest": "_render"
		},
		{
			"src": "^/connect/discord/?$",
			"dest": "_render"
		},
		{
			"src": "^/connect/socials/?$",
			"dest": "_render"
		},
		{
			"src": "^/feedback/?$",
			"dest": "_render"
		},
		{
			"src": "^/join/newsletter/?$",
			"dest": "_render"
		},
		{
			"src": "^/join/stuorg/?$",
			"dest": "_render"
		},
		{
			"src": "^/password/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}