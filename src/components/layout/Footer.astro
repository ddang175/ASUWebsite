---
import { createServerClient } from '../../lib/supabase/server';

const year = new Date().getFullYear();

type LinkGroup = { heading: string; items: Array<{ label: string; href: string }> };

// Fallback used when nav_links / site_settings are empty or unreachable, so
// the site keeps working even before Supabase is seeded.
const DEFAULT_LINKS: LinkGroup[] = [
  {
    heading: 'About',
    items: [
      { label: 'About Us',        href: '/about' },
      { label: 'Executive Board', href: '/board' },
    ],
  },
  {
    heading: 'Join',
    items: [
      { label: 'Student Organization', href: '/join/stuorg' },
      { label: 'Newsletter',           href: '/join/newsletter' },
    ],
  },
  {
    heading: 'Connect',
    items: [
      { label: 'Socials', href: '/connect/socials' },
    ],
  },
  {
    heading: 'More',
    items: [
      { label: 'Looped',   href: '/looped' },
      { label: 'Feedback', href: '/feedback' },
    ],
  },
];

const DEFAULT_DISCLAIMER =
  "The views and opinions expressed on this website are strictly those of the Asian Student " +
  "Union at Iowa State University and its members. The contents of these pages have not been " +
  "reviewed or approved by Iowa State University. This is not an official Iowa State University " +
  'website.';

const supabase = createServerClient(Astro.cookies);
const { data: navRows } = await supabase
  .from('nav_links')
  .select('*')
  .eq('is_visible', true)
  .order('display_order');

let links: LinkGroup[];

if (navRows && navRows.length > 0) {
  const groupsMap = new Map<string, Array<{ label: string; href: string }>>();
  const ungrouped: Array<{ label: string; href: string }> = [];

  for (const row of navRows) {
    if (row.href === '/') continue; // Footer omits the Home link, same as before
    if (row.parent_group) {
      if (!groupsMap.has(row.parent_group)) groupsMap.set(row.parent_group, []);
      groupsMap.get(row.parent_group)!.push({ label: row.label, href: row.href });
    } else {
      ungrouped.push({ label: row.label, href: row.href });
    }
  }

  links = Array.from(groupsMap, ([heading, items]) => ({ heading, items }));
  if (ungrouped.length > 0) {
    links.push({ heading: 'More', items: ungrouped });
  }
} else {
  links = DEFAULT_LINKS;
}

const { data: settingsRows } = await supabase
  .from('site_settings')
  .select('*')
  .eq('key', 'footer_disclaimer');

const footerDisclaimer = settingsRows?.[0]?.value ?? DEFAULT_DISCLAIMER;
---

<footer class="bg-asu-espresso text-asu-cream">
  <div class="max-w-[1280px] mx-auto px-8 md:px-16 py-16">

    <div class="flex flex-col md:flex-row gap-12 md:gap-16">

      <!-- Logo + tagline -->
      <div class="shrink-0 md:w-56">
        <a href="/" aria-label="Asian Student Union — home" class="inline-block mb-4 opacity-90 hover:opacity-100 transition-opacity duration-200">
          <img
            src="/images/asu-logo.webp"
            alt="Asian Student Union logo"
            class="h-14 w-auto"
            style="filter: brightness(0) invert(1);"
          />
        </a>
     
      </div>

      <!-- Nav link columns -->
      <div class="flex flex-wrap gap-10 md:gap-16 flex-1">
        {links.map((group) => (
          <div class="min-w-[120px]">
            <p class="font-ui text-[11px] font-bold tracking-[0.1em] uppercase mb-4"
               style="color: rgba(252,238,201,0.40);">
              {group.heading}
            </p>
            <ul class="space-y-2.5 list-none m-0 p-0">
              {group.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="font-ui text-sm font-medium text-asu-cream/70 hover:text-asu-cream transition-colors duration-150"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

    </div>

    <!-- Divider + disclaimer + copyright -->
    <div
      class="mt-14 pt-6 flex flex-col gap-3"
      style="border-top: 1px solid rgba(252,238,201,0.10);"
    >
      <p class="font-ui text-xs leading-relaxed max-w-3xl" style="color: rgba(252,238,201,0.38);">
        {footerDisclaimer}
      </p>
      <p class="font-ui text-xs" style="color: rgba(252,238,201,0.28);">
        © {year} Asian Student Union at Iowa State University. All rights reserved.
      </p>
    </div>

  </div>
</footer>
