---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Join ASU — Asian Student Union"
  description="Learn how to become an official member of the Asian Student Union at Iowa State. Pay your dues and join the community."
>
  <main class="flex-1 bg-asu-ivory overflow-x-hidden">

    <!-- ── 1. Compact page header ─────────────────────────────────────── -->
    <section
      class="relative bg-asu-espresso text-asu-cream overflow-hidden px-6 md:px-14"
      style="min-height: 340px; padding-top: 80px; padding-bottom: 72px;"
    >


      <!-- Text content -->
      <div class="relative max-w-5xl mx-auto text-center" style="z-index: 3;">

        <!-- Eyebrow -->
        <div class="flex items-center justify-center gap-4 mb-5">
          <div class="w-7 h-px bg-asu-gold opacity-70" />
          <p class="font-ui text-[12px] font-bold tracking-[0.26em] uppercase text-asu-gold opacity-90">
            Asian Student Union · Membership
          </p>
          <div class="w-7 h-px bg-asu-gold opacity-70" />
        </div>

        <!-- Heading -->
        <h1
          class="font-display text-asu-cream leading-none mb-5"
          style="font-size: clamp(3.25rem, 7vw, 5.5rem); letter-spacing: -0.02em;"
        >
          Join ASU
        </h1>

        <!-- Subtitle -->
        <p
          class="font-body leading-relaxed max-w-sm mx-auto"
          style="font-size: 1.1rem; color: rgba(252,238,201,0.72);"
        >
          Become an officially recognized member<br />
          of the Asian Student Union at Iowa State University.
        </p>

        <!-- Gold rule -->
        <div class="mt-7 mx-auto bg-asu-gold" style="height: 1.5px; width: 48px;" />

      </div>
    </section>

    <!-- ── 2. Main content — requirements + benefits ──────────────────── -->
    <section style="padding: 80px 56px 88px;">
      <div class="max-w-5xl mx-auto">

        <div class="grid md:grid-cols-2 gap-14 lg:gap-24">

          <!-- ── LEFT: Requirements ──────────────────────────────────── -->
          <div>

            <!-- Section label -->
            <div class="flex items-center gap-3 mb-6">
              <div class="w-6 h-px bg-asu-red" />
              <p class="font-ui text-[12px] font-bold tracking-[0.22em] uppercase text-asu-red">
                Membership Requirements
              </p>
            </div>

            <h2
              class="font-display text-asu-dark leading-tight mb-9"
              style="font-size: clamp(2rem, 3.5vw, 2.75rem); letter-spacing: -0.01em;"
            >
              To be an official<br />member, you need:
            </h2>

            <!-- Requirement 1 -->
            <div class="flex items-start gap-5 mb-7">
              <div
                class="flex-shrink-0 w-11 h-11 rounded-full bg-asu-red flex items-center justify-center"
                aria-hidden="true"
              >
                <span class="font-display text-asu-cream text-xl leading-none">1</span>
              </div>
              <div>
                <p class="font-ui font-semibold text-[17px] text-asu-dark mb-1.5">
                  Be an enrolled ISU student
                </p>
                <p class="font-body text-[15px] leading-relaxed text-asu-muted">
                  Membership is open to all currently enrolled students at
                  Iowa State University, regardless of major or year.
                </p>
              </div>
            </div>

            <!-- Requirement 2 -->
            <div class="flex items-start gap-5 mb-11">
              <div
                class="flex-shrink-0 w-12 h-12 rounded-full bg-asu-red flex items-center justify-center"
                aria-hidden="true"
              >
                <span class="font-display text-asu-cream text-xl leading-none">2</span>
              </div>
              <div>
                <p class="font-ui font-semibold text-[17px] text-asu-dark mb-1.5">
                  Pay your membership dues
                </p>
                <p class="font-body text-[15px] leading-relaxed text-asu-muted">
                  Dues officially add you to the ASU member roster in the
                  Iowa State student organization database.
                </p>
              </div>
            </div>

            <!-- Divider -->
            <div class="w-full h-px bg-asu-beige mb-9" />

            <!-- CTA buttons -->
            <div class="flex flex-col sm:flex-row gap-3">
              <!-- Purchase Dues: no link yet — greyed out placeholder -->
              <span
                class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-asu-beige/50 text-asu-muted font-ui font-semibold text-[15px] tracking-[0.04em] rounded cursor-not-allowed select-none border border-dashed border-asu-muted/30"
                aria-disabled="true"
              >
                Purchase Dues
                <span class="font-bold tracking-widest text-asu-brown/60">- Not Available</span>
              </span>
              <a
                href="https://www.stuorg.iastate.edu/asu"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 px-8 py-4 border border-asu-dark/20 text-asu-dark font-ui font-semibold text-[15px] tracking-[0.04em] rounded transition-colors duration-200 hover:bg-asu-dark hover:text-asu-cream"
              >
                Student Org Page
                <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
                  <path d="M2 11 L11 2 M5 2h6v6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>

          </div>

          <!-- ── RIGHT: Benefits ─────────────────────────────────────── -->
          <div>

            <!-- Section label -->
            <div class="flex items-center gap-3 mb-6">
              <div class="w-6 h-px bg-asu-gold" />
              <p class="font-ui text-[12px] font-bold tracking-[0.22em] uppercase text-asu-brown">
                Member Benefits
              </p>
            </div>

            <h2
              class="font-display text-asu-dark leading-tight mb-9"
              style="font-size: clamp(2rem, 3.5vw, 2.75rem); letter-spacing: -0.01em;"
            >
              What you get as<br />a dues-paying member
            </h2>

            <!-- Benefits list -->
            <ul class="space-y-6">

              <li class="flex items-start gap-4">
                <span
                  class="flex-shrink-0 mt-0.5 w-6 h-6 rounded-full bg-asu-gold/20 flex items-center justify-center"
                  aria-hidden="true"
                >
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                    <path d="M2 6.5l2.5 2.5 5.5-5" stroke="#E8C66A" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <div>
                  <p class="font-ui font-semibold text-[16px] text-asu-dark mb-1">
                    Official member status
                  </p>
                  <p class="font-body text-[15px] leading-relaxed text-asu-muted">
                    You're added to the ASU member roster in the ISU
                    student organization database as an official member of ASU.
                  </p>
                </div>
              </li>

              <li class="flex items-start gap-4">
                <span
                  class="flex-shrink-0 mt-0.5 w-6 h-6 rounded-full bg-asu-gold/20 flex items-center justify-center"
                  aria-hidden="true"
                >
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                    <path d="M2 6.5l2.5 2.5 5.5-5" stroke="#E8C66A" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <div>
                  <p class="font-ui font-semibold text-[16px] text-asu-dark mb-1">
                    Voting rights during officer elections
                  </p>
                  <p class="font-body text-[15px] leading-relaxed text-asu-muted">
                    Obtain the opportunity to vote for the next leaders of ASU, directly impacting the future of the community.
                  </p>
                </div>
              </li>

              <li class="flex items-start gap-4">
                <span
                  class="flex-shrink-0 mt-0.5 w-6 h-6 rounded-full bg-asu-gold/20 flex items-center justify-center"
                  aria-hidden="true"
                >
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                    <path d="M2 6.5l2.5 2.5 5.5-5" stroke="#E8C66A" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <div>
                  <p class="font-ui font-semibold text-[16px] text-asu-dark mb-1">
                    Officer eligibility
                  </p>
                  <p class="font-body text-[15px] leading-relaxed text-asu-muted">
                    Only dues-paying members are eligible to apply for
                    executive board positions when applications open.
                  </p>
                </div>
              </li>

              <li class="flex items-start gap-4">
                <span
                  class="flex-shrink-0 mt-0.5 w-6 h-6 rounded-full bg-asu-gold/20 flex items-center justify-center"
                  aria-hidden="true"
                >
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                    <path d="M2 6.5l2.5 2.5 5.5-5" stroke="#E8C66A" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <div>
                  <p class="font-ui font-semibold text-[16px] text-asu-dark mb-1">
                    Free/Discounted Food
                  </p>
                  <p class="font-body text-[15px] leading-relaxed text-asu-muted">
                    Official members can get free/discounted food at several ASU events.
                  </p>
                </div>
              </li>

              <li class="flex items-start gap-4">
                <span
                  class="flex-shrink-0 mt-0.5 w-6 h-6 rounded-full bg-asu-gold/20 flex items-center justify-center"
                  aria-hidden="true"
                >
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                    <path d="M2 6.5l2.5 2.5 5.5-5" stroke="#E8C66A" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <div>
                  <p class="font-ui font-semibold text-[16px] text-asu-dark mb-1">
                    Looped Eligibility
                  </p>
                  <p class="font-body text-[15px] leading-relaxed text-asu-muted">
                    Only official members get to participate in our new Looped program. To learn more about the Looped program, visit the Looped program page <a href="/looped" class="text-asu-red underline hover:opacity-75 transition-opacity">here</a>.
                  </p>
                </div>
              </li>
 <li class="flex items-start gap-4">
                <span
                  class="flex-shrink-0 mt-0.5 w-6 h-6 rounded-full bg-asu-gold/20 flex items-center justify-center"
                  aria-hidden="true"
                >
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                    <path d="M2 6.5l2.5 2.5 5.5-5" stroke="#E8C66A" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <div>
                  <p class="font-ui font-semibold text-[16px] text-asu-dark mb-1">
                    ASU Points
                  </p>
                  <p class="font-body text-[15px] leading-relaxed text-asu-muted">
                    ASU points can be earned throughout the semester by winning events, attending events, participating in challenges, and more! Only official members are eligible to receive points.
                  </p>
                </div>
              </li>
            </ul>

          </div>

        </div>

      </div>
    </section>

    <!-- ── 3. Bottom note ─────────────────────────────────────────────── -->
    <div
      class="border-t border-asu-beige"
      style="padding: 36px 56px;"
    >
      <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-start sm:items-center gap-3 sm:gap-8">
        <p class="font-body text-[15px] leading-relaxed text-asu-muted flex-1">
          Questions about membership? Reach out to us on our socials or at
          a General Body Meeting. We're happy to help.
        </p>
        <a
          href="/connect/socials"
          class="font-ui text-[13px] font-semibold tracking-[0.08em] uppercase text-asu-red hover:text-asu-red-hover transition-colors duration-200 whitespace-nowrap"
        >
          Find us online →
        </a>
      </div>
    </div>

  </main>
</Layout>
