---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Looped — Asian Student Union @ Iowa State University"
  description="Looped — more details coming soon from the Asian Student Union at Iowa State University."
>
  <main class="flex-1">
    <section class="relative overflow-hidden bg-asu-ivory min-h-[60vh] flex items-center justify-center">
      <div class="max-w-[1280px] mx-auto px-8 md:px-16 py-24 text-center">
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-asu-dark mb-6">
          Looped
        </h1>
        <div class="w-16 h-0.5 bg-asu-red mx-auto mb-8"></div>
        <p class="font-ui text-lg md:text-xl text-asu-dark/70 max-w-xl mx-auto mb-4">
          This page is under construction.
        </p>
        <p class="font-ui text-base text-asu-dark/50 max-w-md mx-auto">
          More details will be coming soon. Stay tuned!
        </p>
      </div>
    </section>
  </main>
</Layout>
