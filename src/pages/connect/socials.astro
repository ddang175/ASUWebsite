---
import Layout from '../../layouts/Layout.astro';
import { SocialsHero } from '../../components/socials/SocialsHero';
import { createServerClient } from '../../lib/supabase/server';

const supabase = createServerClient(Astro.cookies, Astro.request.headers);
const { data: settings } = await supabase.from('site_settings').select('*');
const s = Object.fromEntries((settings ?? []).map((r) => [r.key, r.value]));
---

<Layout
  title="Socials — Asian Student Union"
  description="Follow ASU on Instagram, TikTok, and Discord to stay connected with events, updates, and club life."
>
  <main class="flex-1">
    <SocialsHero
      client:load
      instagramUrl={s.instagram_url ?? ''}
      instagramHandle={s.instagram_handle ?? ''}
      tiktokUrl={s.tiktok_url ?? ''}
      tiktokHandle={s.tiktok_handle ?? ''}
      discordUrl={s.discord_url ?? ''}
      discordHandle={s.discord_handle ?? ''}
    />
  </main>
</Layout>
