# ──────────────────────────────────────────────────────────────────────────────
# ASU Website — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is git-ignored; never commit it.
#
# EVENTS_SHEET_ID
# ─────────────────────────────────────────────────────────────────────────────
# The ID of your Google Sheet that holds upcoming event data.
#
# How to find it:
#   Open your Google Sheet → look at the URL:
#   https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit
#
# Required sheet setup:
#   1. File → Share → "Anyone with the link" → set to Viewer
#   2. Row 1 must have these exact headers (case-insensitive):
#        Title | Date | Start Time | End Time | Location | Description |
#        Image URL | Collab | RSVP URL | Tags
#   3. Put the current event in row 2. Only row 2 is read.
#
# If this variable is not set, or if the fetch fails, the site falls back to
# the static data in src/data/events.json.
# ──────────────────────────────────────────────────────────────────────────────
EVENTS_SHEET_ID=your_google_sheet_id_here
